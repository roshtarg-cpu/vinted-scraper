{
  "title": "Vinted Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchUrl": {
      "title": "Search URL",
      "type": "string",
      "description": "Vinted catalog URL to scrape (e.g., https://www.vinted.com/catalog?brand_ids[]=53&catalog[]=1193)",
      "editor": "textfield",
      "example": "https://www.vinted.com/catalog",
      "prefill": "https://www.vinted.com/catalog"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of listings to scrape",
      "editor": "number",
      "default": 50,
      "prefill": 10,
      "minimum": 1,
      "maximum": 10000
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for bypassing Cloudflare (recommended: RESIDENTIAL)",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"],
        "apifyProxyCountry": "US"
      },
      "editor": "proxy"
    }
  },
  "required": []
}
